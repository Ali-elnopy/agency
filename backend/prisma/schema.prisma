
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model JobTitle {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  users User[]

  @@map("job_titles")
}

model User {
  id           Int       @id @default(autoincrement())
  fullName     String    @map("full_name") @db.VarChar(150)
  username     String?   @unique @db.VarChar(50)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  phone        String?   @db.VarChar(30)
  roleId       Int       @map("role_id")
  jobTitleId   Int?      @map("job_title_id")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdBy    Int?      @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  role         Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  jobTitle     JobTitle? @relation(fields: [jobTitleId], references: [id], onDelete: SetNull)
  creator      User?     @relation("UserCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  createdUsers User[]    @relation("UserCreator")

  createdTeams Team[]           @relation("TeamCreator")
  ledTeams     Team[]           @relation("TeamLead")
  memberships  TeamMembership[] @relation("MembershipUser")

  managedBrands Brand[] @relation("AccountManager")
  createdBrands Brand[] @relation("BrandCreator")
  clientBrand   Brand?  @relation("ClientBrand")

  failedLoginAttempts    Int       @default(0) @map("failed_login_attempts")
  failedLoginWindowStart DateTime? @map("failed_login_window_start") @db.Timestamptz(6)
  loginLockedUntil       DateTime? @map("login_locked_until") @db.Timestamptz(6)

  sessions AuthSession[]

  passwordResetTokens PasswordResetToken[]

  auditLogs            AuditLog[]
  createdContentPlans  ContentPlan[] @relation("ContentPlanCreator")
  assignedContentPlans ContentPlan[] @relation("ContentPlanAssignee")
  createdCampaigns     Campaign[]    @relation("CampaignCreator")
  createdContentItems  ContentItem[] @relation("ContentItemCreator")

  generatedBriefs BrandBrief[] @relation("BriefGenerator")
  notifications   Notification[] @relation("NotificationRecipient")

  uploadedStrategyVersions StrategyVersion[]  @relation("StrategyUploader")
  strategyFeedbacks        StrategyFeedback[] @relation("StrategyFeedbackRequester")
  strategyApprovals        StrategyApproval[] @relation("StrategyApprover")

  @@index([roleId])
  @@index([jobTitleId])
  @@map("users")
}

model Notification {
  id          Int       @id @default(autoincrement())
  recipientId Int       @map("recipient_id")
  type        String    @db.VarChar(60)
  title       String    @db.VarChar(150)
  message     String    @db.Text
  data        Json?
  isRead      Boolean   @default(false) @map("is_read")
  readAt      DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  recipient User @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, isRead, createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     Int?     @map("user_id")
  action     String   @db.VarChar(100)
  targetType String?  @map("target_type") @db.VarChar(100)
  targetId   String?  @map("target_id") @db.VarChar(100)
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Team {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   Int?     @map("created_by")
  teamLeadId  Int?     @map("team_lead_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  creator     User?            @relation("TeamCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  teamLead    User?            @relation("TeamLead", fields: [teamLeadId], references: [id], onDelete: SetNull)
  memberships TeamMembership[]
  brands      Brand[]

  @@index([teamLeadId])
  @@map("teams")
}

model TeamMembership {
  teamId   Int      @map("team_id")
  userId   Int      @map("user_id")
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_memberships")
}

model Brand {
  id               Int      @id @default(autoincrement())
  name             String   @db.VarChar(150)
  industry         String?  @db.VarChar(100)
  websiteUrl       String?  @map("website_url")
  description      String?
  status           String   @default("active") @db.VarChar(20)
  clientId         Int?     @unique @map("client_id")
  accountManagerId Int?     @map("account_manager_id")
  teamId           Int?     @map("team_id")
  createdBy        Int?     @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  client           User?             @relation("ClientBrand", fields: [clientId], references: [id], onDelete: Restrict)
  accountManager   User?             @relation("AccountManager", fields: [accountManagerId], references: [id], onDelete: Restrict)
  team             Team?             @relation(fields: [teamId], references: [id], onDelete: Restrict)
  creator          User?             @relation("BrandCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  platformAccounts PlatformAccount[]
  contentPlans     ContentPlan[]

  onboarding ClientOnboarding?
  strategies Strategy[]

  @@index([accountManagerId])
  @@index([teamId])
  @@map("brands")
}

model ClientOnboarding {
  id              Int       @id @default(autoincrement())
  brandId         Int       @unique @map("brand_id")
  mainCategory    String    @map("main_category") @db.VarChar(30)
  activityType    String    @map("activity_type") @db.VarChar(50)
  templateVersion String    @map("template_version") @db.VarChar(20)
  status          String    @default("DRAFT") @db.VarChar(20)
  submittedAt     DateTime? @map("submitted_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  brand   Brand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  answers OnboardingAnswer[]
  briefs  BrandBrief[]

  @@index([status])
  @@map("client_onboardings")
}

model OnboardingAnswer {
  id           Int      @id @default(autoincrement())
  onboardingId Int      @map("onboarding_id")
  questionCode String   @map("question_code") @db.VarChar(100)
  answer       Json
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  onboarding ClientOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)

  @@unique([onboardingId, questionCode])
  @@map("onboarding_answers")
}

model BrandBrief {
  id            Int    @id @default(autoincrement())
  onboardingId  Int    @map("onboarding_id")
  generatedById Int    @map("generated_by_id")
  version       Int    @default(1)
  status        String @default("GENERATING") @db.VarChar(20)

  content        Json?
  sourceSnapshot Json?   @map("source_snapshot")
  modelName      String? @map("model_name") @db.VarChar(100)
  promptVersion  String  @map("prompt_version") @db.VarChar(20)
  errorMessage   String? @map("error_message")

  generatedAt DateTime? @map("generated_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  onboarding  ClientOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  generatedBy User             @relation("BriefGenerator", fields: [generatedById], references: [id], onDelete: Restrict)

  @@unique([onboardingId, version])
  @@index([status])
  @@index([generatedById])
  @@map("brand_briefs")
}

model Permission {
  id          Int     @id @default(autoincrement())
  code        String  @unique @db.VarChar(100)
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           Int       @map("user_id")
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  userAgent        String?   @map("user_agent") @db.VarChar(500)
  ipAddress        String?   @map("ip_address") @db.VarChar(45)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model PlatformAccount {
  id          Int      @id @default(autoincrement())
  brandId     Int      @map("brand_id")
  platform    String   @db.VarChar(30)
  accountName String   @map("account_name") @db.VarChar(200)
  accountUrl  String?  @map("account_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  brand        Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  contentPlans ContentPlan[]

  @@index([brandId])
  @@map("platform_accounts")
}

model ContentPlan {
  id                Int      @id @default(autoincrement())
  brandId           Int      @map("brand_id")
  platformAccountId Int      @map("platform_account_id")
  title             String   @db.VarChar(200)
  year              Int      @db.SmallInt
  month             Int      @db.SmallInt
  monthlyGoals      String?  @map("monthly_goals") @db.Text
  notes             String?  @db.Text
  status            String   @default("DRAFT") @db.VarChar(30)
  createdBy         Int      @map("created_by")
  assignedToId      Int?     @map("assigned_to_id")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  brand           Brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  platformAccount PlatformAccount @relation(fields: [platformAccountId], references: [id], onDelete: Restrict)
  creator         User            @relation("ContentPlanCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  assignedTo      User?           @relation("ContentPlanAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  campaigns    Campaign[]
  contentItems ContentItem[]

  @@unique([brandId, platformAccountId, year, month])
  @@index([brandId])
  @@index([platformAccountId])
  @@index([createdBy])
  @@index([assignedToId])
  @@index([year, month])
  @@map("content_plans")
}

model Campaign {
  id            Int      @id @default(autoincrement())
  contentPlanId Int      @map("content_plan_id")
  name          String   @db.VarChar(200)
  objective     String?  @db.Text
  startDate     DateTime @map("start_date") @db.Timestamptz(6)
  endDate       DateTime @map("end_date") @db.Timestamptz(6)
  createdBy     Int      @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  contentPlan ContentPlan @relation(fields: [contentPlanId], references: [id], onDelete: Cascade)
  creator     User        @relation("CampaignCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  contentItems ContentItem[]

  @@index([contentPlanId])
  @@index([createdBy])
  @@index([startDate, endDate])
  @@map("campaigns")
}

model ContentItem {
  id            Int  @id @default(autoincrement())
  contentPlanId Int  @map("content_plan_id")
  campaignId    Int? @map("campaign_id")
  createdBy     Int  @map("created_by")

  scheduledDate DateTime @map("scheduled_date") @db.Timestamptz(6)
  type          String   @db.VarChar(50)
  title         String   @db.VarChar(200)

  reference   String? @db.Text
  toneOfVoice String? @map("tone_of_voice") @db.Text
  caption     String? @db.Text
  notes       String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  contentPlan ContentPlan @relation(fields: [contentPlanId], references: [id], onDelete: Cascade)
  campaign    Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  creator     User        @relation("ContentItemCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([contentPlanId])
  @@index([campaignId])
  @@index([createdBy])
  @@index([scheduledDate])
  @@map("content_items")
}

// Strategy Module

model Strategy {
  id        Int      @id @default(autoincrement())
  brandId   Int      @map("brand_id")
  title     String   @db.VarChar(200)
  status    String   @default("DRAFT") @db.VarChar(30)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  brand    Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  versions StrategyVersion[]

  @@index([brandId])
  @@index([status])
  @@map("strategies")
}

model StrategyVersion {
  id           Int      @id @default(autoincrement())
  strategyId   Int      @map("strategy_id")
  version      Int
  storageKey   String   @map("storage_key") @db.VarChar(500)
  fileName     String   @map("file_name") @db.VarChar(255)
  mimeType     String   @default("application/pdf") @map("mime_type") @db.VarChar(100)
  fileSize     Int      @map("file_size")
  uploadedById Int      @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  strategy   Strategy           @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  uploadedBy User               @relation("StrategyUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  feedback   StrategyFeedback[]
  approvals  StrategyApproval[]

  @@unique([strategyId, version])
  @@index([uploadedById])
  @@map("strategy_versions")
}

model StrategyFeedback {
  id          Int       @id @default(autoincrement())
  versionId   Int       @map("version_id")
  requestedBy Int       @map("requested_by")
  message     String    @db.Text
  status      String    @default("OPEN") @db.VarChar(20)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz(6)

  version   StrategyVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  requester User            @relation("StrategyFeedbackRequester", fields: [requestedBy], references: [id], onDelete: Restrict)

  @@index([versionId])
  @@index([requestedBy])
  @@index([status])
  @@map("strategy_feedback")
}

model StrategyApproval {
  id           Int      @id @default(autoincrement())
  versionId    Int      @map("version_id")
  approverId   Int      @map("approver_id")
  approverType String   @map("approver_type") @db.VarChar(30)
  decision     String   @db.VarChar(20)
  comment      String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  version  StrategyVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  approver User            @relation("StrategyApprover", fields: [approverId], references: [id], onDelete: Restrict)

  @@unique([versionId, approverType])
  @@index([approverId])
  @@map("strategy_approvals")
}
