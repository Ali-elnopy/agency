generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl =env("DIRECT_URL")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model JobTitle {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  users User[]

  @@map("job_titles")
}

model User {
  id           Int       @id @default(autoincrement())
  fullName     String    @map("full_name") @db.VarChar(150)
  username     String?   @unique @db.VarChar(50)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  phone        String?   @db.VarChar(30)
  roleId       Int       @map("role_id")
  jobTitleId   Int?      @map("job_title_id")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdBy    Int?      @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  role         Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  jobTitle     JobTitle? @relation(fields: [jobTitleId], references: [id], onDelete: SetNull)
  creator      User?     @relation("UserCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  createdUsers User[]    @relation("UserCreator")

  createdTeams Team[]           @relation("TeamCreator")
  ledTeams     Team[]           @relation("TeamLead")
  memberships  TeamMembership[] @relation("MembershipUser")

  managedBrands Brand[] @relation("AccountManager")
  createdBrands Brand[] @relation("BrandCreator")
  clientBrand   Brand?  @relation("ClientBrand")

  failedLoginAttempts    Int       @default(0) @map("failed_login_attempts")
  failedLoginWindowStart DateTime? @map("failed_login_window_start") @db.Timestamptz(6)
  loginLockedUntil       DateTime? @map("login_locked_until") @db.Timestamptz(6)

  sessions AuthSession[]

  passwordResetTokens PasswordResetToken[]

  auditLogs AuditLog[]

  @@index([roleId])
  @@index([jobTitleId])
  @@map("users")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     Int?     @map("user_id")
  action     String   @db.VarChar(100)
  targetType String?  @map("target_type") @db.VarChar(100)
  targetId   String?  @map("target_id") @db.VarChar(100)
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Team {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   Int?     @map("created_by")
  teamLeadId  Int?     @map("team_lead_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  creator     User?            @relation("TeamCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  teamLead    User?            @relation("TeamLead", fields: [teamLeadId], references: [id], onDelete: SetNull)
  memberships TeamMembership[]
  brands      Brand[]

  @@index([teamLeadId])
  @@map("teams")
}

model TeamMembership {
  teamId   Int      @map("team_id")
  userId   Int      @map("user_id")
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_memberships")
}

model Brand {
  id               Int      @id @default(autoincrement())
  name             String   @db.VarChar(150)
  industry         String?  @db.VarChar(100)
  websiteUrl       String?  @map("website_url")
  description      String?
  status           String   @default("active") @db.VarChar(20)
  clientId         Int?     @unique @map("client_id")
  accountManagerId Int?     @map("account_manager_id")
  teamId           Int?     @map("team_id")
  createdBy        Int?     @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  client         User? @relation("ClientBrand", fields: [clientId], references: [id], onDelete: Restrict)
  accountManager User? @relation("AccountManager", fields: [accountManagerId], references: [id], onDelete: Restrict)
  team           Team? @relation(fields: [teamId], references: [id], onDelete: Restrict)
  creator        User? @relation("BrandCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([accountManagerId])
  @@index([teamId])
  @@map("brands")
}

model Permission {
  id          Int     @id @default(autoincrement())
  code        String  @unique @db.VarChar(100)
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           Int       @map("user_id")
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  userAgent        String?   @map("user_agent") @db.VarChar(500)
  ipAddress        String?   @map("ip_address") @db.VarChar(45)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

// Password reset links. The table already exists (see the
// 20261022120000_add_audit_logs_and_password_reset_tokens migration); the
// model was missing, which is why the reset flow had no backend behind it.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}
