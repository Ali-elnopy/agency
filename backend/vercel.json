{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --include=dev",
  "buildCommand": "npx prisma generate",
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/[...path]"
    },
    {
      "source": "/",
      "destination": "/api/[...path]"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/[...path]"
    }
  ],
  "functions": {
    "api/[...path].js": {
      "maxDuration": 30
    }
  }
}
