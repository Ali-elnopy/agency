NODE_ENV=development
PORT=5000

# PostgreSQL
DATABASE_URL="postgresql://agency:agency@localhost:5432/agency_db?schema=public"

# JWT (غيّرهم بقيم عشوائية طويلة: openssl rand -hex 48)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

# CORS (مفصولة بفاصلة)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend URL (لروابط reset password)
FRONTEND_URL=http://localhost:5173

# أول Admin (بيتعمل بالـ seed)
SEED_ADMIN_EMAIL=admin@agency.local
SEED_ADMIN_PASSWORD=ChangeMe123!


