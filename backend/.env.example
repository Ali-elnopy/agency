# Copy this file to `.env` and adjust the values.

NODE_ENV=development
PORT=5001

# PostgreSQL.
# Quick start with Docker (matches docker-compose.yml):
DATABASE_URL="postgresql://agency:agency@127.0.0.1:5432/agency_db?schema=public"
# Workspace default (local PostgreSQL on port 5433, database "agency"):
# DATABASE_URL="postgresql://agency:agency@127.0.0.1:5433/agency?schema=public"
# Hosted (Neon, Render...): use the direct connection string, e.g.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
#
# Supabase: use the Session Pooler URL and append the Prisma pooler flags.
# Without them Prisma can fail with P1001 or prepared-statement errors.
# DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?pgbouncer=true&connection_limit=1"
#
# If `prisma migrate` fails through the pooler, temporarily use the direct
# connection string for the migration, then switch back to the pooler URL.

# JWT (use a long random value: openssl rand -hex 48)
JWT_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

# CORS (comma separated). Include every origin that serves the frontend.
CLIENT_URL=http://localhost:5173,http://localhost:5199

# Frontend URL (used in reset-password links)
FRONTEND_URL=http://localhost:5173

# Transactional email for "forgot password" links.
# Configure ONE transport. Without one the endpoint answers 503 and never
# pretends a message was sent.
#
# Option A — Resend (works well on Vercel):
#   RESEND_API_KEY=re_xxxxxxxx
#   MAIL_FROM="ORVIA <no-reply@yourdomain.com>"
# Option B — SMTP (Gmail App Password, Brevo, Mailtrap, ...):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-app-password
RESEND_API_KEY=
MAIL_FROM="ORVIA <no-reply@orvia-agency.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# First Admin (created by the seed)
SEED_ADMIN_EMAIL=admin@agency.local
SEED_ADMIN_PASSWORD=ChangeMe123!
