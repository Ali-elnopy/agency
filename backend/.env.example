# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5001

# ---------------------------------------------------------------------------
# Database (PostgreSQL / Prisma)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Use a random string of at least 32 characters. Never commit the real value.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

# ---------------------------------------------------------------------------
# URLs / CORS
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Transactional email — preferred provider: Resend
# ---------------------------------------------------------------------------
# Get a key at https://resend.com/api-keys and verify a sending domain at
# https://resend.com/domains. During development you may use the testing sender
# `onboarding@resend.dev`, but it can only deliver to your own Resend account
# email until a domain is verified.
RESEND_API_KEY=re_your_resend_api_key

# Must be a verified sender/domain for real inbox delivery, e.g.:
#   ORVIA <no-reply@your-verified-domain.com>
MAIL_FROM="ORVIA <onboarding@resend.dev>"

# Shown in the email copy and footer.
APP_NAME=ORVIA

# ---------------------------------------------------------------------------
# Optional fallback: SMTP (Nodemailer)
# Used when RESEND_API_KEY is empty. For Gmail use an App Password, not your
# account password. For iCloud use an app-specific password.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your.address@gmail.com
SMTP_PASS=your_google_app_password

# Legacy aliases accepted by the mailer:
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# APPLE_EMAIL=
# APPLE_APP_PASSWORD=
