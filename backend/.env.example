# Copy this file to .env and adjust the values.

NODE_ENV=development
PORT=5001

# PostgreSQL. The workspace runs a local instance (database "agency", port 5433).
# Hosted Supabase alternative (session pooler):
# DATABASE_URL="postgresql://postgres.walqebnqucphzhxzatfg:FviROR8cLiktlEKw@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"
DATABASE_URL="postgresql://agency:agency@127.0.0.1:5433/agency?schema=public"

# JWT (use long random values: openssl rand -hex 48)
JWT_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

# CORS (comma separated)
CLIENT_URL=http://localhost:5173,http://localhost:5199

# Frontend URL (used in reset-password links)
FRONTEND_URL=http://localhost:5173

# First Admin (created by the seed)
SEED_ADMIN_EMAIL=admin@agency.local
SEED_ADMIN_PASSWORD=ChangeMe123!
