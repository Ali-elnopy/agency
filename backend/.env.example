# Server
PORT=5001
NODE_ENV=development

# Database (PostgreSQL / Supabase / Neon / Render / Docker)
# Local Docker: postgresql://agency:agency@localhost:5432/agency_db?schema=public
# Or hosted Supabase/Neon: postgresql://postgres.[project]:[password]@[host]:5432/postgres?schema=public
DATABASE_URL="postgresql://agency:agency@localhost:5432/agency_db?schema=public"
DIRECT_URL="postgresql://agency:agency@localhost:5432/agency_db?schema=public"

# Authentication (minimum 32 characters)
JWT_SECRET="orvia-super-secure-jwt-secret-minimum-32-chars-key-2026"
JWT_ACCESS_EXPIRES_IN="15m"
REFRESH_TOKEN_TTL_DAYS=30

# CORS & Frontend URLs
CLIENT_URL="http://localhost:5173,http://localhost:3000"
FRONTEND_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Email Configuration (for password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Orvia Agency OS <noreply@orvia.com>"
