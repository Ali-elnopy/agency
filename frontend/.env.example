# Backend API (proxied by Vite in dev, see vite.config.js)
VITE_API_BASE_URL=/api/v1

# Local demo mode. The mock never activates in a production build,
# regardless of this value.
VITE_USE_MOCK_API=true
VITE_MOCK_NAME=Elena Vance
VITE_MOCK_EMAIL=elena.vance@orvia-creative.com
VITE_MOCK_PASSWORD=password1234
VITE_MOCK_ADMIN_EMAIL=admin@agency.local
VITE_MOCK_ADMIN_PASSWORD=ChangeMe123!

# Local development only: lets an empty sign-in form open the dashboard with a
# fake ADMIN session. Has no effect in a production build, even when set.
VITE_DEV_BYPASS_LOGIN=false
